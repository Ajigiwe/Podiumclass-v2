# Production environment for the VPS. Copy to deploy/.env and fill in:
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#
# deploy/.env holds real secrets and is gitignored. Nothing here is a working
# credential -- every value must be replaced before the first boot, and the
# stack refuses to start without the ones marked REQUIRED.

# --- Hostnames --------------------------------------------------------------
# The web app and the API share one hostname (nginx proxies /api inside the
# frontend container), so the browser never makes a cross-origin request.
APP_DOMAIN=podiumclass.online
APP_ORIGIN=https://podiumclass.online

# LiveKit signalling. Point an A record at the same VPS. Media itself flows
# directly over TCP 7881 and UDP 50000-50100, not through this name.
LIVEKIT_DOMAIN=livekit.podiumclass.online

# Let's Encrypt account contact (expiry notices only).
ACME_EMAIL=admin@podiumclass.online

# --- Django -----------------------------------------------------------------
# REQUIRED. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Key for the external attendance/Laravel integration. May stay empty if that
# integration is not used.
ATTENDANCE_API_KEY=

# HTTP Strict Transport Security, in seconds. Leave at 0 until HTTPS has been
# verified end to end (padlock, no mixed content), then set 31536000. Browsers
# remember it for that long, so enabling it on a broken certificate is painful
# to undo.
DJANGO_SECURE_HSTS_SECONDS=0

# --- Database (REQUIRED password) -------------------------------------------
POSTGRES_DB=podium
POSTGRES_USER=podium
# Generate with: openssl rand -base64 32 | tr -d '/+=' | head -c 40
# If it contains @ : / or ?, percent-encode it -- it is placed into a URL.
POSTGRES_PASSWORD=

# --- LiveKit (REQUIRED) -----------------------------------------------------
# The server, the egress worker and Django all share this pair. A known secret
# lets anyone mint a join token for any room.
#   LIVEKIT_API_KEY: any short identifier, e.g. APIpodium<6 hex chars>
#   LIVEKIT_API_SECRET: at least 32 random characters (openssl rand -hex 32)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Keep true on a VPS. Docker's bridge network hides the host's public address,
# so without this LiveKit advertises a 172.x container IP, signalling works and
# media silently fails. Set false only if outbound STUN is blocked -- then also
# pin rtc.node_ip in deploy/livekit.yaml.template to the public address.
LIVEKIT_USE_EXTERNAL_IP=true

# Where the egress worker writes MP4s, as seen *inside its container*. Must stay
# in step with RECORDINGS_CONTAINER_PATH in docker-compose.prod.yml.
EGRESS_OUTPUT_DIR=/out/recordings

# --- Web app build-time settings -------------------------------------------
# Google OAuth client id (project -> Credentials -> OAuth client, type "Web").
# Also add https://<APP_DOMAIN> to that client's Authorized JavaScript
# origins, or sign-in fails with origin_mismatch.
GOOGLE_CLIENT_ID=

# PostHog is optional; blank keeps analytics off and the SPA no-ops.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Only needed for a split deployment (frontend on a different origin than the
# API). Blank means deploy.sh allows APP_ORIGIN, which is the normal same-origin
# setup.
CORS_ALLOWED_ORIGINS=
