# Copy to .env.local (dev) or .env (compose) and fill in real values.
# Nothing here is a real credential; every value must be replaced.
#
# Generate the Django secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

# --- Django backend ---------------------------------------------------------
# MUST be False in production. Unset defaults to False (secure), so local
# development has to opt in explicitly.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-value

# Comma-separated. Required when DJANGO_DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated browser origins. Wildcard is dev-only; credentials require an
# explicit list.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- Service credentials ----------------------------------------------------
# Authorises the external attendance API. Rotate if it has ever been committed.
ATTENDANCE_API_KEY=

# LiveKit room-token signing. A known secret lets anyone mint a token.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_URL=wss://livekit.example.com

# --- Docker Compose / Postgres ----------------------------------------------
POSTGRES_DB=podium
POSTGRES_USER=podium
POSTGRES_PASSWORD=

# --- Frontend (Vite) --------------------------------------------------------
# Must match the backend port (8000). The vite proxy and the axios default both
# point here; keep them in sync.
VITE_API_URL=http://localhost:8000

# --- Third-party (currently unused by the Django backend) -------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
