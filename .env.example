# Copy to .env.local (dev) or .env (compose) and fill in real values.
# Nothing here is a real credential; every value must be replaced.
#
# Generate the Django secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

# --- Django backend ---------------------------------------------------------
# MUST be False in production. Unset defaults to False (secure), so local
# development has to opt in explicitly.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-value

# Comma-separated. Required when DJANGO_DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated browser origins. Required when DJANGO_DEBUG=False.
# In development, loopback and private-LAN origins (10.x, 172.16-31.x, 192.168.x,
# *.local) on any port are accepted automatically, so a phone can use the
# machine's current LAN IP without editing this line. Keep real, public
# frontend origins here.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- Service credentials ----------------------------------------------------
# Authorises the external attendance API. Rotate if it has ever been committed.
ATTENDANCE_API_KEY=

# LiveKit room-token signing. A known secret lets anyone mint a token.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_URL=wss://livekit.example.com

# --- Docker Compose / Postgres ----------------------------------------------
POSTGRES_DB=podium
POSTGRES_USER=podium
POSTGRES_PASSWORD=

# --- Frontend (Vite) --------------------------------------------------------
# Must match the backend port (8000). The vite proxy and the axios default both
# point here; keep them in sync.
VITE_API_URL=http://localhost:8000
# PostHog product analytics (project API key, not a personal one). Blank keeps
# analytics off entirely: the SPA no-ops instead of sending events.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# The OAuth client the web app signs in with. Blank uses the client built into
# the source, so a checkout with nothing set behaves exactly as before.
# (Vite reads these from frontend/.env or the shell environment, not this file.)
VITE_GOOGLE_CLIENT_ID=
# Origins that client has registered as Authorized JavaScript origins. Google
# refuses any other origin with "origin_mismatch"; listing them here lets the
# app explain that in its own UI instead of a popup that looks like a dud.
# Defaults to http://localhost:3000,http://127.0.0.1:3000.
VITE_GOOGLE_ALLOWED_ORIGINS=

# --- Third-party (currently unused by the Django backend) -------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
