# --- Secrets (never commit) -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Databases & backups ----------------------------------------------------
*.sqlite3
db.sqlite3
db.sqlite3-*
*.bak
*.bak-*
*.dump

# --- Django -----------------------------------------------------------------
staticfiles/
media/

# --- Node / frontend --------------------------------------------------------
node_modules/
dist/
.vite/
*.local

# --- Deployment -------------------------------------------------------------
# Rendered LiveKit/Egress configs embed the API secret; the templates in
# deploy/ are the versioned half.
deploy/generated/
# Uploads, recordings and avatars, bind-mounted into the containers on the VPS.
# Root-anchored: an unanchored `data/` also matches the Android source package
# online.podiumclass.app.data, which silently hides new Kotlin files there.
/data/

# --- Local artifacts --------------------------------------------------------
# Local LiveKit server binary + generated dev config (contains the API secret).
.livekit/
# Runtime output from local runs: these were one `git add -A` away from being
# committed along with whatever they recorded.
.backend.log
*.log
.podium/
.freebuff/
scratch/
android/.kotlin/
# Generated by backend/scripts/loadtest_seed.py; holds 200 access tokens.
loadtest/manifest.json
# Built web bundle packaged for upload to the static host (frontend/dist is
# already ignored; this is the zip made from it).
podium-web.zip
# Archive of the previous system: it embeds its own .env with live credentials.
podium-lms-package.zip

# --- Android ----------------------------------------------------------------
# Gradle state and the machine-local SDK path: neither is shared between
# developers, and local.properties records where this machine installed the
# Android SDK.
android/.gradle/
android/local.properties
android/build/
android/app/build/

# --- OS / editors -----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
