<?xml version="1.0" encoding="utf-8"?>
<!--
  The Podium mark, matching the web app: a mortarboard in white on the brand
  indigo (the web header draws the same glyph, and the web app icon the same
  cap on blue). Kept as vectors so it is crisp from a 16dp notification glyph
  to the adaptive launcher foreground.

  The path is the standard 24-unit mortarboard: the band first (so the board
  sits on top of it), then the board with its hanging tassel.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M5,13.18v4L12,21l7,-3.82v-4L12,17l-7,-3.82z" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,3L1,9l11,6 9,-4.91V17h2V9L12,3z" />
</vector>
