<?xml version="1.0" encoding="utf-8"?>
<!-- Only the exports folder is exposed: a content:// URI cannot walk out of
     the directory named here. -->
<paths>
    <cache-path name="exports" path="exports/" />
    <!-- Recordings on Android 8/9 live in the app's external Movies folder,
         because the public one would need a storage permission. Sharing one is
         a content:// URI scoped to that folder. -->
    <external-files-path name="recordings" path="Movies/" />
</paths>
